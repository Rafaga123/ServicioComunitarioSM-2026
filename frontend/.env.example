# Recomendado: NO definir VITE_API_URL. `npm run dev` y `npm run dev:remoto`
# ya redirigen `/api` al backend con el proxy de vite.config.js.
# Si necesitas apuntar directamente a otra API, incluye el prefijo /api:
VITE_API_URL=http://localhost:8000/api
# Remoto (Tailscale): http://servidor-servicio:8000/api
