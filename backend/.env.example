POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contrasena_secreta
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=database
DEBUG=True

# Directorio físico donde se guardan los adjuntos de pases y reportes.
# Ejemplos:
# STORAGE_ROOT=C:\sistema
# STORAGE_ROOT=/srv/servicio-comunitario/sistema
STORAGE_ROOT=C:\sistema

# Reutilizar PDFs cuando los datos del listado no cambiaron (default False).
# REUTILIZAR_DOCUMENTOS_IGUALES=True

SECRET_KEY=cambia_esta_clave_por_una_larga_y_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=360

# Límite anti fuerza bruta del login (en memoria por proceso).
# LIMITE_LOGIN_INTENTOS=5        # fallos por (IP, usuario) en la ventana
# LIMITE_LOGIN_IP=20             # intentos por IP (incluye logins correctos)
# LIMITE_LOGIN_VENTANA_SEGUNDOS=60
# TOKENS_REVOCADOS_RETENCION_HORAS=24
